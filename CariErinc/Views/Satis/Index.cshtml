@model SatisIndexVM
@{
    ViewData["Title"] = "Satışlar";
    var musteriler = ViewBag.Musteriler as SelectList;
    var musteriId = Model.MusteriId;
    var tip = Model.Tip ?? "";
    var baslangic = Model.Baslangic;
    var bitis = Model.Bitis;
}

@Html.AntiForgeryToken()

<!-- Page Header -->
<div class="page-header mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Dashboard</a></li>
            <li class="breadcrumb-item active" aria-current="page">Satış Geçmişi</li>
        </ol>
    </nav>
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h3 fw-bold mb-0 text-primary-container">📈 Satış ve Hareketler</h1>
            <p class="text-muted small mb-0 mt-1">Tamamlanan satışların ve müşteri ödemelerinin dijital küratörlüğü</p>
        </div>
        <a asp-action="Form" class="btn btn-primary px-4 rounded-pill fw-bold shadow-sm d-flex align-items-center gap-2">
            <span class="material-symbols-outlined">point_of_sale</span> Yeni Satış Yap
        </a>
    </div>
</div>

<!-- Glass Filter Card -->
<div class="card border-0 shadow-premium rounded-4 mb-4 bg-white overflow-hidden">
    <div class="card-body p-4">
        <form method="get" class="row g-3 align-items-end">
            <input type="hidden" name="page" value="1" />
            <div class="col-md-3">
                <label for="musteriId" class="form-label extra-small fw-bold text-uppercase text-muted ls-wide mb-2">Müşteri</label>
                <div class="position-relative">
                    <span class="material-symbols-outlined position-absolute top-50 start-0 translate-middle-y ms-3 text-muted fs-5">person_search</span>
                    <select id="musteriId" name="musteriId" class="form-select border-0 bg-surface-container-low ps-5 py-2 rounded-3">
                        @if (musteriler != null)
                        {
                            @foreach (SelectListItem item in musteriler)
                            {
                                <option value="@item.Value" selected="@(item.Value == (musteriId?.ToString() ?? ""))">@item.Text</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-2">
                <label for="tip" class="form-label extra-small fw-bold text-uppercase text-muted ls-wide mb-2">Ödeme Tipi</label>
                <select id="tip" name="tip" class="form-select border-0 bg-surface-container-low py-2 rounded-3">
                    <option value="" selected="@(tip == "")">Tüm Tipler</option>
                    <option value="Pesin" selected="@(tip == "Pesin")">Peşin</option>
                    <option value="Veresiye" selected="@(tip == "Veresiye")">Veresiye</option>
                </select>
            </div>
            <div class="col-md-2">
                <label for="baslangic" class="form-label extra-small fw-bold text-uppercase text-muted ls-wide mb-2">Başlangıç</label>
                <input type="date" id="baslangic" name="baslangic" value="@baslangic" class="form-control border-0 bg-surface-container-low py-2 rounded-3" />
            </div>
            <div class="col-md-2">
                <label for="bitis" class="form-label extra-small fw-bold text-uppercase text-muted ls-wide mb-2">Bitiş</label>
                <input type="date" id="bitis" name="bitis" value="@bitis" class="form-control border-0 bg-surface-container-low py-2 rounded-3" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <div class="form-check align-self-center mt-3">
                    <input class="form-check-input" type="checkbox" name="dahilIptaller" value="true" id="dahilIptaller" @(Model.DahilIptaller ? "checked" : "") />
                    <label class="form-check-label small fw-medium" for="dahilIptaller">İptalleri Göster</label>
                </div>
                <button type="submit" class="btn btn-primary-container flex-grow-1 rounded-3 py-2 fw-bold">Filtrele</button>
                <a asp-action="Index" class="btn btn-surface rounded-3 py-2 px-3 shadow-none border" title="Temizle">
                    <span class="material-symbols-outlined align-middle fs-5">restart_alt</span>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Transaction Table -->
<div class="card border-0 shadow-premium rounded-4 overflow-hidden bg-white">
    <div class="card-header bg-transparent py-4 px-4 border-0 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-primary-container">🧾 Satış Belgeleri</h5>
    </div>
    <div class="table-responsive">
        @if (Model.Satislar.Any())
        {
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-surface-container-low text-on-surface">
                    <tr>
                        <th class="ps-4 py-3 fw-semibold">Tarih & Fiş No</th>
                        <th class="py-3 fw-semibold">Müşteri Detayı</th>
                        <th class="py-3 fw-semibold">Ödeme Yöntemi</th>
                        <th class="py-3 fw-semibold text-end">Toplam Tutar</th>
                        <th class="py-3 pe-4 text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Satislar)
                    {
                        <tr class="@(s.IptalEdildi ? "opacity-50 text-muted grayscale" : "")">
                            <td class="ps-4">
                                <div class="fw-medium">@s.Tarih.ToLocalTime().ToTrDateTime()</div>
                                <div class="text-muted extra-small">
                                    #DOC-@s.Id.ToString("D5")
                                    @if (s.IptalEdildi) { <span class="badge bg-secondary-container text-secondary ms-1">İPTAL</span> }
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="p-2 bg-surface-container rounded-circle d-flex align-items-center justify-content-center" style="width:36px; height:36px;">
                                        <span class="material-symbols-outlined text-on-surface fs-5">account_circle</span>
                                    </div>
                                    <div>
                                        <div class="fw-semibold text-dark">@(s.Musteri != null ? $"{s.Musteri.Ad} {s.Musteri.Soyad}".Trim() : "Peşin Müşteri")</div>
                                        @if (s.KismiIade && !s.IptalEdildi) { <div class="text-warning extra-small fw-bold animate-pulse">⚠️ Kısmi İade Yapıldı</div> }
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (s.OdemeTipi == OdemeTipi.Pesin)
                                {
                                    <span class="badge rounded-pill bg-success-container text-success px-3">
                                        <span class="material-symbols-outlined align-middle fs-6 me-1">payments</span> Peşin
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-warning-container text-warning px-3">
                                        <span class="material-symbols-outlined align-middle fs-6 me-1">credit_score</span> Veresiye
                                    </span>
                                }
                            </td>
                            <td class="text-end fw-bold text-primary">@s.ToplamTutar.ToTrParaMoney()</td>
                            <td class="pe-4 text-end">
                                <div class="d-flex justify-content-end align-items-center gap-1">
                                    <a asp-action="Detail" asp-route-id="@s.Id" class="btn-list-action btn-list-action-view" title="Detaylar">
                                        <span class="material-symbols-outlined">visibility</span>
                                    </a>
                                    @if (!s.IptalEdildi)
                                    {
                                        <a asp-action="Form" asp-route-id="@s.Id" class="btn-list-action btn-list-action-edit" title="Düzenle">
                                            <span class="material-symbols-outlined">edit</span>
                                        </a>
                                        <button type="button" class="btn-list-action btn-list-action-delete btn-delete" 
                                                data-url="@Url.Action("Sil", new { id = s.Id })"
                                                data-title="Satış İptali"
                                                data-text="Bu satışı tamamen iptal etmek istediğinize emin misiniz? Tüm stok ve finansal hareketler geri alınacaktır.">
                                            <span class="material-symbols-outlined">block</span>
                                        </button>
                                    }
                                    <a asp-action="Fis" asp-route-id="@s.Id" class="btn-list-action btn-list-action-view" title="Fiş Yazdır">
                                        <span class="material-symbols-outlined">print</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5">
                <div class="display-1 text-muted opacity-25">receipt_long</div>
                <p class="text-muted mt-3">Herhangi bir satış kaydı bulunamadı.</p>
                <a asp-action="Index" class="btn btn-link text-decoration-none">Filtreleri Sıfırla</a>
            </div>
        }
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-transparent border-0 py-3 px-4">
            @await Html.PartialAsync("_Pagination", new PaginationInfo
            {
                Action = "Index",
                CurrentPage = Model.CurrentPage,
                TotalPages = Model.TotalPages,
                RouteValues = new Dictionary<string, string>
                {
                    ["musteriId"] = Model.MusteriId?.ToString() ?? "",
                    ["tip"] = Model.Tip ?? "",
                    ["baslangic"] = Model.Baslangic ?? "",
                    ["bitis"] = Model.Bitis ?? "",
                    ["dahilIptaller"] = Model.DahilIptaller ? "true" : "false"
                }
            })
        </div>
    }
</div>
