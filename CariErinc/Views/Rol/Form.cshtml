@model RolVM
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? $"Rol Düzenle: {Model.Ad}" : "Yeni Rol";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-link text-decoration-none mb-2">← Listeye dön</a>
    <h2>@ViewData["Title"]</h2>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form asp-action="Save" method="post" style="max-width: 500px;">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="mb-3">
                <label asp-for="Ad" class="form-label fw-semibold small"></label>
                <input asp-for="Ad" class="form-control" placeholder="Örn: Muhasebe, Personel..." />
                <span asp-validation-for="Ad" class="text-danger small"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Aciklama" class="form-label fw-semibold small"></label>
                <textarea asp-for="Aciklama" class="form-control" rows="3" placeholder="Rol için açıklama (opsiyonel)..."></textarea>
                <span asp-validation-for="Aciklama" class="text-danger small"></span>
            </div>
            
            <div class="mb-4">
                <div class="form-check form-switch border rounded p-3 @(Model.IsAdmin ? "bg-light" : "")">
                    <input class="form-check-input ms-0 me-3" type="checkbox" asp-for="IsAdmin" id="isAdminSwitch">
                    <label class="form-check-label fw-bold @(Model.IsAdmin ? "text-danger" : "")" for="isAdminSwitch">
                        Admin Yetkisi
                    </label>
                    <div class="form-text small mt-1 ps-0">Bu rol seçildiğinde tüm yetki kontrolleri atlanır ve tam erişim sağlanır.</div>
                </div>
            </div>
            
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">Kaydet</button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">İptal</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScripts" />
}
