@model DashboardVM
@{
    ViewData["Title"] = "Dashboard";
}
<!-- Welcome Section -->
<div class="page-header mb-5">
    <div class="row align-items-center">
        <div class="col-auto">
            <div class="p-3 bg-primary-container text-primary rounded-4 shadow-sm">
                <span class="material-symbols-outlined fs-1">analytics</span>
            </div>
        </div>
        <div class="col">
            <h1 class="h3 fw-bold mb-1 text-primary-container">Hoş Geldiniz, Yunus</h1>
            <p class="text-muted mb-0">İşletmenizin bugünkü performansı ve kritik stok durumları aşağıdadır.</p>
        </div>
        <div class="col-auto">
            <div class="bg-white p-2 rounded-pill shadow-sm d-flex align-items-center gap-2 px-3 border">
                <span class="material-symbols-outlined text-muted fs-5">calendar_today</span>
                <span class="fw-bold small">@DateTime.Now.ToString("dd MMMM yyyy")</span>
            </div>
        </div>
    </div>
</div>

<!-- Key Metrics Bento Grid -->
<div class="row g-4 mb-5">
    <div class="col-sm-6 col-md-3">
        <div class="card border-0 shadow-premium rounded-4 h-100 bg-white">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between mb-3">
                    <div class="p-2 bg-primary-container-low rounded-3 text-primary">
                        <span class="material-symbols-outlined">trending_up</span>
                    </div>
                    <span class="badge bg-primary-container text-primary rounded-pill px-2 py-1">Bugün</span>
                </div>
                <div class="h3 fw-bold mb-1">@Model.BugunkuSatisToplam.ToString("N2") ₺</div>
                <div class="text-muted extra-small text-uppercase fw-bold ls-wide">Günlük Ciro</div>
                <div class="mt-3 overflow-hidden rounded-pill bg-surface-container-low" style="height: 6px;">
                    <div class="bg-primary h-100" style="width: 75%;"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card border-0 shadow-premium rounded-4 h-100 bg-white">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between mb-3">
                    <div class="p-2 bg-success-container-low rounded-3 text-success">
                        <span class="material-symbols-outlined">account_balance</span>
                    </div>
                    <span class="badge bg-success-container text-success rounded-pill px-2 py-1">Nakit</span>
                </div>
                <div class="h3 fw-bold mb-1">@Model.KasaBakiyesi.ToString("N2") ₺</div>
                <div class="text-muted extra-small text-uppercase fw-bold ls-wide">Kasa Mevcudu</div>
                <div class="mt-3 d-flex gap-1 align-items-end" style="height: 20px;">
                    <div class="bg-success-container flex-grow-1 rounded-top" style="height: 40%;"></div>
                    <div class="bg-success-container flex-grow-1 rounded-top" style="height: 60%;"></div>
                    <div class="bg-success flex-grow-1 rounded-top" style="height: 90%;"></div>
                    <div class="bg-success-container flex-grow-1 rounded-top" style="height: 70%;"></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card border-0 shadow-premium rounded-4 h-100 bg-white border-start border-4 border-danger">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between mb-3">
                    <div class="p-2 bg-danger-container-low rounded-3 text-danger">
                        <span class="material-symbols-outlined">pending_actions</span>
                    </div>
                    <span class="badge bg-danger-container text-danger rounded-pill px-2 py-1">Veresiye</span>
                </div>
                <div class="h3 fw-bold mb-1">@Model.AcikVeresiyeToplam.ToString("N2") ₺</div>
                <div class="text-muted extra-small text-uppercase fw-bold ls-wide">Açık Borçlar</div>
                <div class="mt-2 text-muted small fw-medium">
                    <span class="badge bg-surface-container-high text-on-surface rounded-pill px-2">@Model.AcikVeresiyeMusteriSayisi Müşteri</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card border-0 shadow-premium rounded-4 h-100 @(Model.KritikStokSayisi > 0 ? "bg-warning-container-low border-warning" : "bg-white")">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between mb-3">
                    <div class="p-2 @(Model.KritikStokSayisi > 0 ? "bg-warning text-white" : "bg-success-container-low text-success") rounded-3 shadow-sm">
                        <span class="material-symbols-outlined">inventory_2</span>
                    </div>
                    <span class="badge @(Model.KritikStokSayisi > 0 ? "bg-warning text-white" : "bg-success-container text-success") rounded-pill px-2 py-1">Stok</span>
                </div>
                <div class="h3 fw-bold mb-1 @(Model.KritikStokSayisi > 0 ? "text-warning-darker" : "text-success")">@Model.KritikStokSayisi Adet</div>
                <div class="text-muted extra-small text-uppercase fw-bold ls-wide">Kritik Stok Uyarısı</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Reports Content Space (Placeholders) -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-premium rounded-4 overflow-hidden bg-white h-100">
            <div class="card-header bg-transparent py-4 px-4 border-0">
                <h5 class="fw-bold mb-0">📉 Satış Analitiği (Haftalık)</h5>
                <p class="text-muted small mb-0 mt-1">Son 7 günlük performans grafiği</p>
            </div>
            <div class="card-body p-4 pt-0 d-flex flex-column justify-content-center">
                <!-- Visual Placeholder for Chart -->
                <div class="chart-placeholder bg-surface-container-low rounded-4 d-flex align-items-end gap-3 p-4">
                    <div class="bg-primary opacity-25 flex-grow-1 rounded-3" style="height: 30%;"></div>
                    <div class="bg-primary opacity-50 flex-grow-1 rounded-3" style="height: 45%;"></div>
                    <div class="bg-primary opacity-25 flex-grow-1 rounded-3" style="height: 25%;"></div>
                    <div class="bg-primary opacity-75 flex-grow-1 rounded-3" style="height: 60%;"></div>
                    <div class="bg-primary opacity-50 flex-grow-1 rounded-3" style="height: 50%;"></div>
                    <div class="bg-primary flex-grow-1 rounded-3" style="height: 85%;"></div>
                    <div class="bg-primary-container flex-grow-1 rounded-3 border border-primary border-dashed" style="height: 40%;"></div>
                </div>
                <div class="mt-4 d-flex justify-content-around text-muted extra-small fw-bold">
                    <span>Pzt</span><span>Sal</span><span>Çar</span><span>Per</span><span>Cum</span><span>Cmt</span><span>Paz</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Critical Stock Table -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-premium rounded-4 overflow-hidden bg-white h-100">
            <div class="card-header bg-transparent py-4 px-4 border-0">
                <h5 class="fw-bold mb-0">⚠️ Kritik Stok Listesi</h5>
            </div>
            <div class="table-responsive">
                @if (Model.KritikStokUrunleri.Any())
                {
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-surface-container-low text-on-surface">
                            <tr>
                                <th class="ps-4">Ürün</th>
                                <th class="text-center">Stok</th>
                                <th class="pe-4 text-center">Kritik</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var urun in Model.KritikStokUrunleri)
                            {
                                <tr>
                                    <td class="ps-4 fw-medium text-dark">@urun.Ad</td>
                                    <td class="text-center">
                                        <span class="badge rounded-pill @(urun.StokAdedi <= 0 ? "bg-danger" : "bg-warning text-dark") px-3">@urun.StokAdedi</span>
                                    </td>
                                    <td class="pe-4 text-center text-muted small">@urun.MinStokUyari</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center py-5">
                        <span class="material-symbols-outlined fs-1 text-success opacity-50 mb-2">check_circle</span>
                        <p class="text-muted fw-medium">Tüm stoklar güvenli seviyede.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
