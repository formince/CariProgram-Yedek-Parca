@model AlisIndexVM
@{
    ViewData["Title"] = "Alışlar";
    var tedarikciler = ViewBag.Tedarikciler as SelectList;
}
@Html.AntiForgeryToken()
<!-- Page Header -->
<div class="page-header mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Dashboard</a></li>
            <li class="breadcrumb-item active" aria-current="page">Alış Geçmişi</li>
        </ol>
    </nav>
        <div class="d-flex gap-2">
            <button type="button" onclick="faturaWizard.open()" class="btn btn-outline-primary px-4 rounded-pill fw-bold shadow-sm d-flex align-items-center gap-2">
                <span class="material-symbols-outlined">auto_fix</span> Fatura Sihirbazı (AI)
            </button>
            <a asp-action="Form" class="btn btn-primary px-4 rounded-pill fw-bold shadow-sm d-flex align-items-center gap-2">
                <span class="material-symbols-outlined">add_circle</span> Yeni Alış Kaydı
            </a>
        </div>
    </div>
</div>

<!-- Fatura Sihirbazı Modalı -->
<div class="modal fade" id="modalFaturaWizard" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow-premium rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold text-primary-container d-flex align-items-center gap-2">
                    <span class="material-symbols-outlined fs-3">auto_fix</span> Akıllı Fatura Sihirbazı
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="wizardContent">
                <!-- İçerik faturaWizard.js tarafından doldurulacak -->
                <div class="text-center py-5" id="dropZone">
                    <div class="display-3 text-primary opacity-25 mb-3">upload_file</div>
                    <h5 class="fw-bold">Fatura dosyasını buraya sürükleyin</h5>
                    <p class="text-muted">veya dosya seçmek için tıklayın (.xml, .pdf, .jpg, .png)</p>
                    <input type="file" id="faturaFile" class="d-none" accept=".xml,.pdf,.png,.jpg,.jpeg" />
                    <button type="button" class="btn btn-primary-container rounded-pill px-4 mt-2" onclick="document.getElementById('faturaFile').click()">
                        Dosya Seç
                    </button>
                </div>
            </div>
            <div class="modal-footer border-0 p-4">
                <button type="button" class="btn btn-surface rounded-pill px-4" data-bs-dismiss="modal">Kapat</button>
                <button type="button" id="btnSihirbazTamamla" class="btn btn-primary rounded-pill px-5 fw-bold d-none" onclick="faturaWizard.applyToForm()">
                    Verileri Aktar ve Kapat
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Glass Filter Card -->
<div class="card border-0 shadow-premium rounded-4 mb-4 bg-white overflow-hidden">
    <div class="card-body p-4">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label for="tedarikciId" class="form-label extra-small fw-bold text-uppercase text-muted ls-wide mb-2">Tedarikçi</label>
                <div class="position-relative">
                    <span class="material-symbols-outlined position-absolute top-50 start-0 translate-middle-y ms-3 text-muted fs-5">store</span>
                    <select id="tedarikciId" name="tedarikciId" class="form-select border-0 bg-surface-container-low ps-5 py-2 rounded-3">
                        <option value="">Tüm Tedarikçiler</option>
                        @if (tedarikciler != null)
                        {
                            foreach (SelectListItem item in tedarikciler)
                            {
                                <option value="@item.Value" selected="@(item.Value == (Model.TedarikciId?.ToString() ?? ""))">@item.Text</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <label for="baslangic" class="form-label extra-small fw-bold text-uppercase text-muted ls-wide mb-2">Başlangıç Tarihi</label>
                <input type="date" id="baslangic" name="baslangic" value="@Model.Baslangic" class="form-control border-0 bg-surface-container-low py-2 rounded-3" />
            </div>
            <div class="col-md-3">
                <label for="bitis" class="form-label extra-small fw-bold text-uppercase text-muted ls-wide mb-2">Bitiş Tarihi</label>
                <input type="date" id="bitis" name="bitis" value="@Model.Bitis" class="form-control border-0 bg-surface-container-low py-2 rounded-3" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary-container flex-grow-1 rounded-3 py-2 fw-bold">
                    <span class="material-symbols-outlined align-middle fs-5">filter_list</span> Filtrele
                </button>
                <a asp-action="Index" class="btn btn-surface rounded-3 py-2 px-3 shadow-none border" title="Filtreleri Temizle">
                    <span class="material-symbols-outlined align-middle fs-5">restart_alt</span>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Transaction Table -->
<div class="card border-0 shadow-premium rounded-4 overflow-hidden bg-white">
    <div class="card-header bg-transparent py-4 px-4 border-0 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0">📦 Kayıtlı Belgeler <span class="badge bg-surface-container-high text-on-surface rounded-pill ms-2 px-3 py-1 fs-6">@Model.TotalCount</span></h5>
    </div>
    <div class="table-responsive">
        @if (Model.Alislar.Any())
        {
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-surface-container-low text-on-surface">
                    <tr>
                        <th class="ps-4 py-3 fw-semibold">Giriş Tarihi</th>
                        <th class="py-3 fw-semibold">Tedarikçi / Kaynak</th>
                        <th class="py-3 fw-semibold text-end">Toplam Tutar</th>
                        <th class="py-3 fw-semibold">Açıklama</th>
                        <th class="py-3 pe-4 text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Alislar)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-medium">@a.Tarih.ToTrDate()</div>
                                <div class="text-muted extra-small">#TRN-@a.Id.ToString("D4")</div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="p-2 bg-info-container-low rounded-circle d-flex align-items-center justify-content-center" style="width:36px; height:36px;">
                                        <span class="material-symbols-outlined text-info fs-5">receipt_long</span>
                                    </div>
                                    <div class="fw-semibold text-dark">@(a.Tedarikci?.Ad ?? "Genel Tedarik")</div>
                                </div>
                            </td>
                            <td class="text-end fw-bold text-primary">@a.ToplamTutar.ToTrParaMoney()</td>
                            <td>
                                <div class="text-truncate text-muted small" style="max-width: 200px;" title="@a.Aciklama">
                                    @(a.Aciklama ?? "-")
                                </div>
                            </td>
                            <td class="pe-4 text-end">
                                <div class="d-flex justify-content-end align-items-center gap-1">
                                    <a asp-action="Detail" asp-route-id="@a.Id" class="btn-list-action btn-list-action-view" title="Görüntüle">
                                        <span class="material-symbols-outlined">visibility</span>
                                    </a>
                                    @if (a.AlisOdemeleri == null || !a.AlisOdemeleri.Any())
                                    {
                                        <a asp-action="Form" asp-route-id="@a.Id" class="btn-list-action btn-list-action-edit" title="Düzenle">
                                            <span class="material-symbols-outlined">edit</span>
                                        </a>
                                        <button type="button" class="btn-list-action btn-list-action-delete btn-delete" 
                                                data-url="@Url.Action("Sil","Alis", new { id = a.Id })"
                                                data-title="Alış Fişini İptal Et"
                                                data-text="Bu alış fişini iptal edeceksiniz. Stok ve kasa hareketleri geri alınacaktır. Devam etmek istiyor musunuz?">
                                            <span class="material-symbols-outlined">delete</span>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5">
                <p class="text-muted mt-3">Filtrelere uygun alış kaydı bulunamadı.</p>
                <a asp-action="Index" class="btn btn-link text-decoration-none">Tümünü Göster</a>
            </div>
        }
    </div>
    
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-transparent border-0 py-4 px-4">
            @await Html.PartialAsync("_Pagination", new PaginationInfo { 
                CurrentPage = Model.CurrentPage, 
                TotalPages = Model.TotalPages, 
                RouteValues = new Dictionary<string, string> { 
                    { "tedarikciId", Model.TedarikciId?.ToString() ?? "" },
                    { "baslangic", Model.Baslangic ?? "" },
                    { "bitis", Model.Bitis ?? "" }
                } 
            })
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/faturaWizard.js" asp-append-version="true"></script>
}
