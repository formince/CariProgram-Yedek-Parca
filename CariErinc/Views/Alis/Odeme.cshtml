@model Alis
@{
    ViewData["Title"] = "Toptancı Ödemesi";
}

<div class="mb-4">
    <h2>Toptancı Ödemesi</h2>
    <p class="text-muted">@Model.Tedarikci.Ad - Alış #@Model.Id</p>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4 shadow-sm border-0">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title mb-0">Alış Özeti</h5>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span>Toplam Tutar:</span>
                    <span class="fw-bold">@Model.ToplamTutar.ToTrParaMoney()</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Ödenen Toplam:</span>
                    <span class="text-success fw-bold">@Model.OdenenTutar.ToTrParaMoney()</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between">
                    <span class="h5">Kalan Borç:</span>
                    <span class="h5 text-danger fw-bold">@Model.KalanBorc.ToTrParaMoney()</span>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white">
                <h5 class="card-title mb-0">Ödeme Yap</h5>
            </div>
            <div class="card-body">
                <form asp-action="Odeme" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="alisId" value="@Model.Id" />
                    
                    <div class="mb-3">
                        <label class="form-label">Ödeme Tutarı</label>
                        <div class="input-group">
                            <input type="text" name="tutar" class="form-control input-para-tr" inputmode="decimal" autocomplete="off" value="@Model.KalanBorc.ToTrPara()" required />
                            <span class="input-group-text">₺</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Açıklama</label>
                        <textarea name="aciklama" class="form-control" rows="2" placeholder="İsteğe bağlı..."></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success">Ödemeyi Kaydet</button>
                        <a asp-action="VadeliAciklar" class="btn btn-outline-secondary">Vazgeç</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">Geçmiş Ödemeler</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tarih</th>
                            <th class="text-end">Tutar</th>
                            <th>Açıklama</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.AlisOdemeleri.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center py-3 text-muted small">Henüz ödeme yapılmamış.</td>
                            </tr>
                        }
                        @foreach (var o in Model.AlisOdemeleri.OrderByDescending(x => x.OdemeTarihi))
                        {
                            <tr>
                                <td>@o.OdemeTarihi.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-end fw-bold">@o.OdemeTutari.ToTrParaMoney()</td>
                                <td class="small">@o.Aciklama</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
