@model KasaIndexVM
@{
    ViewData["Title"] = "Kasa";
    var baslangic = Model.BaslangicTarihi?.ToString("yyyy-MM-dd");
    var bitis = Model.BitisTarihi?.ToString("yyyy-MM-dd");
}

@Html.AntiForgeryToken()

<div class="row g-4 mb-5">
    <!-- Toplam Bakiye (Ana Kasa) -->
    <div class="col-md-4">
        <div class="stat-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div class="p-3 bg-primary-container text-primary rounded-4">
                    <span class="material-symbols-outlined fs-2">account_balance_wallet</span>
                </div>
                <span class="badge bg-primary-container text-primary rounded-pill px-3 py-1 text-uppercase tracking-wider font-bold" style="font-size: 0.65rem;">Ana Kasa</span>
            </div>
            <p class="text-muted small fw-bold text-uppercase tracking-wider mb-1">Toplam Bakiye</p>
            <div class="fs-1 fw-bold tracking-tighter text-on-surface">@Model.NetBakiye.ToString("N2") <span class="fs-4 text-muted">₺</span></div>
            <div class="mt-4 d-flex align-items-center gap-2 @(Model.NetBakiye >= 0 ? "text-success" : "text-danger") small fw-bold">
                <span class="material-symbols-outlined fs-6">@(Model.NetBakiye >= 0 ? "trending_up" : "trending_down")</span>
                <span>Anlık Durum</span>
            </div>
        </div>
    </div>
    <!-- Günlük Giriş -->
    <div class="col-md-4">
        <div class="stat-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div class="p-3 bg-success-subtle text-success rounded-4" style="background-color: #d1fae5 !important;">
                    <span class="material-symbols-outlined fs-2">payments</span>
                </div>
            </div>
            <p class="text-muted small fw-bold text-uppercase tracking-wider mb-1">Toplam Gelir</p>
            <div class="fs-1 fw-bold tracking-tighter text-on-surface text-success">@Model.ToplamGelir.ToString("N2") <span class="fs-4 text-muted">₺</span></div>
            <div class="mt-4 text-muted small fw-semibold">Dönem içi toplam giriş</div>
        </div>
    </div>
    <!-- Günlük Çıkış -->
    <div class="col-md-4">
        <div class="stat-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div class="p-3 bg-danger-subtle text-danger rounded-4" style="background-color: #ffe4e6 !important;">
                    <span class="material-symbols-outlined fs-2">outbox</span>
                </div>
            </div>
            <p class="text-muted small fw-bold text-uppercase tracking-wider mb-1">Toplam Gider</p>
            <div class="fs-1 fw-bold tracking-tighter text-danger">@Model.ToplamGider.ToString("N2") <span class="fs-4 text-muted">₺</span></div>
            <div class="mt-4">
                 <div class="progress" style="height: 6px; border-radius: 10px; background-color: var(--renk-bg);">
                    <div class="progress-bar bg-danger" role="progressbar" style="width: 25%; border-radius: 10px;"></div>
                </div>
                <p class="text-muted mt-2" style="font-size: 0.7rem;">Gider oranı takibi aktif</p>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-4 mt-2">
    <h3 class="mb-0 fw-bold text-on-surface">İşlem Hareketleri <span class="badge bg-primary-container text-primary rounded-pill align-text-bottom ms-2 fs-6">@Model.TotalCount</span></h3>
    <div class="d-flex gap-2">
         <button class="btn btn-outline-primary shadow-sm">
            <span class="material-symbols-outlined align-middle fs-5 me-1">download</span> Dışa Aktar
        </button>
        <a asp-action="Form" class="btn btn-primary shadow-sm">
            <span class="material-symbols-outlined align-middle fs-5 me-1">add</span> Yeni Tahsilat/Ödeme
        </a>
    </div>
</div>

<div class="card mb-5 border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase tracking-wider text-muted">Açıklama Ara</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-surface-container border-0 rounded-start-3"><span class="material-symbols-outlined fs-6">search</span></span>
                    <input type="text" name="search" value="@Model.SearchTerm" class="form-control border-0 bg-surface-container rounded-end-3" placeholder="Açıklama veya kategori..." />
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-uppercase tracking-wider text-muted">Kategori</label>
                <select name="kategoriId" asp-items="Model.KategoriListesi" class="form-select form-select-sm border-0 bg-surface-container rounded-3">
                    <option value="">Tümü</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-uppercase tracking-wider text-muted">Tür</label>
                <select name="tip" class="form-select form-select-sm border-0 bg-surface-container rounded-3">
                    <option value="">Tümü</option>
                    <!option value="Gelir" @(Model.HareketTipi == KasaHareketTipi.Gelir ? "selected" : "")>Gelir (Giriş)</!option>
                    <!option value="Gider" @(Model.HareketTipi == KasaHareketTipi.Gider ? "selected" : "")>Gider (Çıkış)</!option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-uppercase tracking-wider text-muted">Başlangıç</label>
                <input type="date" name="baslangic" value="@baslangic" class="form-control form-control-sm border-0 bg-surface-container rounded-3" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-uppercase tracking-wider text-muted">Bitiş</label>
                <input type="date" name="bitis" value="@bitis" class="form-control form-control-sm border-0 bg-surface-container rounded-3" />
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary btn-sm w-100 rounded-3">Filtrele</button>
            </div>
        </form>
    </div>
</div>

@if (Model.Hareketler.Any())
{
    <div class="table-wrapper mb-4 rounded-4 shadow-sm border-0">
        <table class="table table-hover mb-0 align-middle">
            <thead class="bg-surface-container-low text-muted font-black text-uppercase tracking-widest" style="font-size: 0.7rem;">
                <tr>
                    <th class="ps-4 py-4">Tarih</th>
                    <th class="py-4">Açıklama / Detay</th>
                    <th class="py-4">Tür</th>
                    <th class="py-4">Kategori</th>
                    <th class="text-end py-4">Tutar</th>
                    <th class="pe-4 py-4" style="width: 80px;"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-surface-container">
                @foreach (var h in Model.Hareketler)
                {
                    <tr class="group hover:bg-light transition-colors">
                        <td class="ps-4 py-4">
                            <p class="mb-0 font-bold text-on-surface small">@h.Tarih.ToLocalTime().ToString("dd MMM yyyy")</p>
                            <p class="mb-0 text-muted" style="font-size: 0.65rem;">@h.Tarih.ToLocalTime().ToString("HH:mm")</p>
                        </td>
                        <td class="py-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="w-8 h-8 rounded-circle bg-light d-flex align-items-center justify-center text-muted">
                                    <span class="material-symbols-outlined fs-6">@(h.HareketTipi == KasaHareketTipi.Gelir ? "shopping_bag" : "outbox")</span>
                                </div>
                                <div>
                                    <p class="mb-0 font-bold text-on-surface small">@(h.Aciklama ?? "İşlem Detayı")</p>
                                    <p class="mb-0 text-muted" style="font-size: 0.65rem;">@(h.HareketTipi == KasaHareketTipi.Gelir ? "Tahsilat" : "Ödeme")</p>
                                </div>
                            </div>
                        </td>
                        <td class="py-4">
                            @if (h.HareketTipi == KasaHareketTipi.Gelir)
                            {
                                <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2 fw-bold text-uppercase tracking-wider" style="font-size: 0.6rem; background-color: #d1fae5 !important;">
                                    <span class="d-inline-block w-1.5 h-1.5 bg-success rounded-circle me-1" style="width:6px; height:6px;"></span> Giriş
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger rounded-pill px-3 py-2 fw-bold text-uppercase tracking-wider" style="font-size: 0.6rem; background-color: #ffe4e6 !important;">
                                    <span class="d-inline-block w-1.5 h-1.5 bg-danger rounded-circle me-1" style="width:6px; height:6px;"></span> Çıkış
                                </span>
                            }
                        </td>
                        <td class="py-4 text-muted small font-medium">@h.Kategori</td>
                        <td class="py-4 text-end">
                            <span class="fw-bold @(h.HareketTipi == KasaHareketTipi.Gelir ? "text-success" : "text-danger")" style="font-size: 0.9rem;">
                                @(h.HareketTipi == KasaHareketTipi.Gelir ? "+" : "-")@h.Tutar.ToTrPara() ₺
                            </span>
                        </td>
                        <td class="pe-4 py-4 text-end">
                            <div class="d-flex justify-content-end gap-1">
                               @if (h.GiderKategori?.SilinebilirMi ?? (h.Kategori != "Alış" && h.Kategori != "Satış"))
                               {
                                    <button type="button" class="btn-list-action btn-list-action-delete btn-delete" 
                                            data-url="@Url.Action("Sil", new { id = h.Id })"
                                            data-title="Kayıt Sil"
                                            data-text="Bu kasa hareketini silmek istediğinize emin misiniz?">
                                        <span class="material-symbols-outlined">delete</span>
                                    </button>
                               }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pagination", new PaginationInfo { 
        CurrentPage = Model.CurrentPage, 
        TotalPages = Model.TotalPages, 
        RouteValues = new Dictionary<string, string> { 
            { "search", Model.SearchTerm ?? "" },
            { "kategoriId", Model.GiderKategoriId?.ToString() ?? "" },
            { "tip", Model.HareketTipi?.ToString() ?? "" },
            { "baslangic", baslangic ?? "" },
            { "bitis", bitis ?? "" }
        } 
    })
}
else
{
    <div class="alert alert-info border-0 shadow-sm">Kasa hareketi bulunamadı.</div>
}
