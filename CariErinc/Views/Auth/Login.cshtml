@model CariErinc.ViewModels.LoginVM
@inject CariErinc.Services.Interfaces.IAyarService AyarSvc
@{
    Layout = null;
    ViewData["Title"] = "Giriş - CariErinc";
    var dukkanAdi = await AyarSvc.GetAsync("DukkanAdi") ?? "Kırtasiye Dükkanı";
}
<!DOCTYPE html>
<html class="light" lang="tr">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>@ViewData["Title"]</title>
    
    <!-- Tailwind CSS (Stitch Integration) -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "on-secondary-fixed": "#002114",
                        "inverse-primary": "#b4c5ff",
                        "on-error": "#ffffff",
                        "on-tertiary-container": "#ffecea",
                        "tertiary": "#ae0010",
                        "surface-bright": "#f7f9fb",
                        "surface-container": "#eceef0",
                        "surface-variant": "#e0e3e5",
                        "surface": "#f7f9fb",
                        "on-primary": "#ffffff",
                        "tertiary-fixed": "#ffdad6",
                        "inverse-surface": "#2d3133",
                        "inverse-on-surface": "#eff1f3",
                        "primary-fixed": "#dbe1ff",
                        "primary": "#004ac6",
                        "primary-container": "#2563eb",
                        "on-surface": "#191c1e",
                        "on-primary-container": "#eeefff",
                        "surface-container-highest": "#e0e3e5",
                        "on-tertiary-fixed": "#410002",
                        "on-tertiary-fixed-variant": "#93000b",
                        "surface-container-low": "#f2f4f6",
                        "on-error-container": "#93000a",
                        "tertiary-fixed-dim": "#ffb4ab",
                        "outline": "#737686",
                        "on-secondary-container": "#00714e",
                        "secondary-container": "#82f5c1",
                        "surface-container-lowest": "#ffffff",
                        "on-surface-variant": "#434655",
                        "error": "#ba1a1a",
                        "surface-dim": "#d8dadc",
                        "primary-fixed-dim": "#b4c5ff",
                        "on-primary-fixed-variant": "#003ea8",
                        "on-background": "#191c1e",
                        "surface-tint": "#0053db"
                    },
                    borderRadius: {
                        "DEFAULT": "1rem",
                        "lg": "2rem",
                        "xl": "3rem",
                        "full": "9999px"
                    },
                    fontFamily: {
                        "headline": ["Inter"],
                        "body": ["Inter"],
                        "label": ["Inter"]
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .glass-panel {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }
    </style>
</head>
<body class="bg-surface text-on-surface selection:bg-primary/20">
<main class="min-h-screen flex flex-col md:flex-row overflow-hidden">
    <!-- Left Side: Visual/Brand Identity -->
    <section class="relative w-full md:w-1/2 lg:w-[60%] h-64 md:h-screen overflow-hidden flex items-center justify-center">
        <!-- Background Image with Overlay -->
        <div class="absolute inset-0 z-0">
            <img class="w-full h-full object-cover" alt="Abstract gradient background" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAZ8dDETpBodHMLvIWap6vX3OscP46Rt3QrcvTkri0Xec3GR-K-oPL46ggLlNu5wbyGGqi1MaqEGhk88A-qKVo0-lynVF-YACyyDigBZ0HhhGt0vrbxRteOHKhXzwv8pOHTg9XEVYz00kEp_Ey1Vx3I2qOkhUSX7CkPekAYa7VtyueKiLsYZ58nupNtuSd-lw5b27k4wZOqClDUbktSDYl3Zv1WoHD508kXc1liHE9kgzPZdOc8mVOYNLCo8l74cnZht02t282vJeJP"/>
            <div class="absolute inset-0 bg-gradient-to-tr from-primary/90 to-transparent mix-blend-multiply"></div>
            <div class="absolute inset-0 bg-black/10"></div>
        </div>
        <!-- Content Container -->
        <div class="relative z-10 w-full max-w-xl px-12 text-white">
            <div class="mb-12">
                <span class="text-4xl lg:text-5xl font-black tracking-tighter block mb-2">@dukkanAdi</span>
                <div class="h-1.5 w-16 bg-white rounded-full"></div>
            </div>
            <h1 class="text-3xl lg:text-5xl font-extrabold tracking-tight mb-6 leading-tight">
                İşletmenizin Finansal <br/>
                <span class="text-white/70 italic font-medium">Yeni Nesil Mimarı.</span>
            </h1>
            <div class="glass-panel p-6 rounded-lg max-w-md">
                <p class="text-white/90 text-lg font-light leading-relaxed">
                    Karmaşık mali süreçlerinizi tek bir platformda, modern ve hızlı bir arayüzle yönetin.
                </p>
            </div>
        </div>
        <!-- Decorative Element -->
        <div class="absolute bottom-12 left-12 flex gap-4 text-white/40 text-xs tracking-widest font-semibold uppercase">
            <span>Enterprise</span>
            <span>•</span>
            <span>Ledger</span>
            <span>•</span>
            <span>v4.0.1</span>
        </div>
    </section>

    <!-- Right Side: Login Form -->
    <section class="w-full md:w-1/2 lg:w-[40%] bg-surface-container-lowest flex flex-col justify-center px-8 md:px-16 lg:px-24 py-16">
        <div class="max-w-md w-full mx-auto">
            <header class="mb-10">
                <h2 class="text-3xl font-extrabold text-on-surface mb-2">Tekrar Hoş Geldiniz</h2>
                <p class="text-outline font-medium">Hesabınıza erişmek için bilgilerinizi giriniz.</p>
            </header>
            
            <form asp-action="Login" method="post" class="space-y-6">
                <!-- Validation Errors -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly" class="text-error text-sm font-semibold mb-4 bg-error-container p-3 rounded-lg"></div>
                }

                <!-- Username Input -->
                <div class="space-y-2">
                    <label asp-for="KullaniciAdi" class="text-sm font-semibold text-on-surface-variant flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">person</span>
                        Kullanıcı Adı
                    </label>
                    <div class="relative group">
                        <input asp-for="KullaniciAdi" type="text" class="w-full h-14 px-6 pr-24 bg-surface-container-high border-none rounded-DEFAULT focus:ring-2 focus:ring-primary/20 transition-all text-on-surface placeholder:text-outline/60 font-medium" placeholder="kullanici" autofocus autocomplete="username" />
                        <div class="absolute top-1/2 -translate-y-1/2 right-4">
                            <span class="text-[10px] font-black text-outline/30 uppercase tracking-tighter">Ready for Scan</span>
                        </div>
                    </div>
                    <span asp-validation-for="KullaniciAdi" class="text-error text-xs font-semibold"></span>
                </div>

                <!-- Password Input -->
                <div class="space-y-2">
                    <div class="flex justify-between items-center">
                        <label asp-for="Sifre" class="text-sm font-semibold text-on-surface-variant flex items-center gap-2">
                            <span class="material-symbols-outlined text-sm">lock</span>
                            Şifre
                        </label>
                    </div>
                    <div class="relative">
                        <input asp-for="Sifre" type="password" class="w-full h-14 px-6 pr-12 bg-surface-container-high border-none rounded-DEFAULT focus:ring-2 focus:ring-primary/20 transition-all text-on-surface placeholder:text-outline/60 font-medium" placeholder="••••••••" autocomplete="current-password" />
                        <button type="button" class="absolute right-4 top-1/2 -translate-y-1/2 text-outline hover:text-primary transition-colors">
                            <span class="material-symbols-outlined">visibility</span>
                        </button>
                    </div>
                    <span asp-validation-for="Sifre" class="text-error text-xs font-semibold"></span>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="w-full h-14 bg-gradient-to-r from-primary to-primary-container text-white font-bold text-lg rounded-xl shadow-[0px_4px_20px_rgba(0,74,198,0.2)] hover:shadow-[0px_10px_30px_rgba(0,74,198,0.3)] hover:scale-[1.01] active:scale-[0.98] transition-all flex items-center justify-center gap-3">
                    Giriş Yap
                    <span class="material-symbols-outlined">login</span>
                </button>
            </form>

            <!-- Alternative Methods / Footer -->
            <div class="mt-10">
                <div class="relative flex items-center py-4">
                    <div class="flex-grow border-t border-outline/10"></div>
                </div>
            </div>
            
            <footer class="mt-6 text-center">
                <p class="text-sm text-outline font-medium">
                    Güvenli erişim sağlanmaktadır. <span class="font-bold">SSL Guard</span>
                </p>
            </footer>
        </div>
    </section>
</main>

<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
