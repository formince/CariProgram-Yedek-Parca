@inject IConfiguration Config
@inject CariErinc.Services.Interfaces.IAyarService AyarSvc
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @(await AyarSvc.GetAsync("DukkanAdi") ?? "Kırtasiye")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/form-premium.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
</head>
<body>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    @await Html.PartialAsync("_Sidebar")
    @await Html.PartialAsync("_Header")
    <main id="main-content" class="main-content">
        @RenderBody()
    </main>
    @await Html.PartialAsync("_Footer")
    <div class="toast-container" id="toastContainer"></div>
    <div class="modal fade" id="globalAjaxModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" id="globalAjaxModalDialog">
            <div class="modal-content border-0 shadow-sm">
                <div class="modal-header">
                    <h5 class="modal-title" id="globalAjaxModalTitle">Form</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body" id="globalAjaxModalBody"></div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/para-tr.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var successMsg = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Success"]?.ToString() ?? ""));
            var errorMsg = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Error"]?.ToString() ?? ""));
            if (successMsg) siteJs.showToast(successMsg, 'success');
            if (errorMsg) siteJs.showToast(errorMsg, 'danger');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
