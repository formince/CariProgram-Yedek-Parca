@inject CariErinc.Services.Interfaces.IAyarService AyarSvc
@{
    var dukkanAdi = await AyarSvc.GetAsync("DukkanAdi") ?? "Kırtasiye Dükkanı";
}
<footer class="app-footer">
    <div class="px-4 py-3 d-flex justify-content-between align-items-center">
        <span class="text-muted small">© @DateTime.Now.Year @dukkanAdi. Tüm hakları saklıdır.</span>
        <span class="text-muted small">Powered by <span class="fw-semibold text-primary">CariErinc</span></span>
    </div>
</footer>
