@model CariErinc.ViewModels.PaginationInfo

@if (Model.TotalPages > 1)
{
    var routeData = new Dictionary<string, string>(Model.RouteValues);
    
    <nav aria-label="Sayfalama">
        <ul class="pagination pagination-sm justify-content-center">
            @* ÖNCEKİ *@
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                @{
                    routeData["page"] = (Model.CurrentPage - 1).ToString();
                }
                <a class="page-link" asp-action="@Model.Action" asp-all-route-data="routeData">Önceki</a>
            </li>

            @* SAYFALAR *@
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                routeData["page"] = i.ToString();
                <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                    <a class="page-link" asp-action="@Model.Action" asp-all-route-data="routeData">@i</a>
                </li>
            }

            @* SONRAKİ *@
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                @{
                    routeData["page"] = (Model.CurrentPage + 1).ToString();
                }
                <a class="page-link" asp-action="@Model.Action" asp-all-route-data="routeData">Sonraki</a>
            </li>
        </ul>
    </nav>
}
