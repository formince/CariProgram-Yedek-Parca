@model GiderKategori
@{
    bool isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Yeni Gider Kategorisi" : "Kategori Düzenle";
}

<div class="form-container-premium">
    <!-- Page Header -->
    <div class="row align-items-center mb-4">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 fs-xs">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Gider Kategorileri</a></li>
                    <li class="breadcrumb-item active text-primary">@(isNew ? "Yeni Kayıt" : "Düzenleme")</li>
                </ol>
            </nav>
            <h2 class="h4 fw-bold mb-0 text-primary-container">
                <span class="material-symbols-outlined align-middle me-1">category</span> 
                @ViewData["Title"]
            </h2>
        </div>
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-link text-muted text-decoration-none d-flex align-items-center gap-1 extra-small">
                <span class="material-symbols-outlined fs-5">close</span> Kapat
            </a>
        </div>
    </div>

    <form asp-action="Save" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-4 p-3 bg-danger-container-low rounded-3 extra-small"></div>

        <div class="row justify-content-center">
            <div class="col-12">
                <div class="form-card-premium shadow-sm">
                    <div class="form-card-header">
                        <span class="material-symbols-outlined text-primary fs-5">settings_suggest</span>
                        <h6>Kategori Tanımlama ve Ayarlar</h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Ad" class="form-label-caps">Kategori Adı</label>
                                <input asp-for="Ad" class="form-control-ghost" placeholder="Örn: Kira, Fatura, Maaş..." autofocus />
                                <span asp-validation-for="Ad" class="text-danger small"></span>
                            </div>

                            <div class="col-12 mt-3">
                                <label class="form-label-caps">İşlem Hareketi Türü</label>
                                @if (isNew)
                                {
                                    <div class="d-flex gap-4 p-3 rounded-4 bg-surface-container-low border border-dashed border-primary">
                                        <div class="form-check">
                                            <input asp-for="Tip" type="radio" value="@KasaHareketTipi.Gelir" class="form-check-input" id="tipGelir" />
                                            <label class="form-check-label fw-bold small cursor-pointer" for="tipGelir">🟢 GELİR</label>
                                        </div>
                                        <div class="form-check">
                                            <input asp-for="Tip" type="radio" value="@KasaHareketTipi.Gider" class="form-check-input" id="tipGider" checked />
                                            <label class="form-check-label fw-bold small cursor-pointer" for="tipGider">🔴 GİDER</label>
                                        </div>
                                    </div>
                                    <div class="extra-small text-muted mt-2 px-1">Seçilen tür kaydedildikten sonra değiştirilemez.</div>
                                    <span asp-validation-for="Tip" class="text-danger small"></span>
                                }
                                else
                                {
                                    <input type="hidden" asp-for="Tip" />
                                    <div class="p-3 rounded-4 bg-surface-container-low border border-dashed text-muted fw-bold small d-flex align-items-center gap-2">
                                        <span class="material-symbols-outlined fs-5">@(Model.Tip == KasaHareketTipi.Gelir ? "arrow_upward" : "arrow_downward")</span>
                                        Haraket Türü: @(Model.Tip == KasaHareketTipi.Gelir ? "GELİR" : "GİDER")
                                    </div>
                                }
                            </div>

                            @if (!isNew)
                            {
                                <div class="col-12 mt-3">
                                    <div class="p-3 rounded-4 bg-surface-container-low border border-dashed d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center gap-3">
                                            <span class="material-symbols-outlined text-primary fs-4">power_settings_new</span>
                                            <div>
                                                <div class="fw-bold small">Kategori Durumu</div>
                                                <div class="extra-small text-muted">Pasif kategoriler seçim listelerinde gizlenir.</div>
                                            </div>
                                        </div>
                                        <div class="form-check form-switch m-0">
                                            <input asp-for="AktifMi" class="form-check-input cursor-pointer" type="checkbox" role="switch" id="aktifMi" style="width: 3rem; height: 1.5rem;">
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Action Bar -->
                <div class="form-actions-bar mt-2 shadow-sm rounded-4">
                    <button type="submit" class="btn btn-primary px-5 py-2 fw-bold shadow-sm d-flex align-items-center gap-2">
                        <span class="material-symbols-outlined">save</span> 
                        @(isNew ? "Kategoriyi Oluştur" : "Değişiklikleri Kaydet")
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 text-decoration-none">Vazgeç</a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScripts" />
}
