@model List<GiderKategori>
@{
    ViewData["Title"] = "Gider Kategorileri";
}

@Html.AntiForgeryToken()

<!-- Page Header -->
<div class="page-header mb-5">
    <div class="row align-items-center">
        <div class="col-auto">
            <div class="p-3 bg-primary-container text-primary rounded-4 shadow-sm">
                <span class="material-symbols-outlined fs-1">category</span>
            </div>
        </div>
        <div class="col">
            <h1 class="h3 fw-bold mb-1 text-primary-container">Gider Kategorileri</h1>
            <p class="text-muted mb-0">Kasa hareketleri ve kategorileri yönetimi</p>
        </div>
        <div class="col-auto">
            <a asp-action="Form" class="btn btn-lg btn-primary">
                <span class="material-symbols-outlined me-2" style="vertical-align: middle; font-size: 1.25rem;">add</span>
                Yeni Kategori
            </a>
        </div>
    </div>
</div>

<div class="table-wrapper">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>Ad</th>
                <th>Tür</th>
                <th>Durum</th>
                <th>Sistem</th>
                <th style="width: 150px;">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var k in Model)
            {
                <tr>
                    <td>@k.Ad</td>
                    <td>
                        <span class="badge @(k.Tip == KasaHareketTipi.Gelir ? "bg-success" : "bg-warning")">
                            @(k.Tip == KasaHareketTipi.Gelir ? "Gelir" : "Gider")
                        </span>
                    </td>
                    <td>
                        <span class="badge @(k.AktifMi ? "bg-info" : "bg-secondary")">
                            @(k.AktifMi ? "Aktif" : "Pasif")
                        </span>
                    </td>
                    <td>
                        @if (!k.SilinebilirMi)
                        {
                            <span class="badge bg-dark">Sistem</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex align-items-center gap-1">
                            <a asp-action="Form" asp-route-id="@k.Id" class="btn-list-action btn-list-action-edit" title="Düzenle">
                                <span class="material-symbols-outlined">edit</span>
                            </a>
                            @if (k.SilinebilirMi)
                            {
                                <button type="button" class="btn-list-action btn-list-action-delete btn-delete" 
                                        data-url="@Url.Action("Sil", new { id = k.Id })"
                                        data-title="Kategoriyi Sil"
                                        data-text="'@k.Ad' kategorisini silmek istediğinize emin misiniz?">
                                    <span class="material-symbols-outlined">delete</span>
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>
