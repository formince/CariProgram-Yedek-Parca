@model VeresiyeRaporVM
<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Veresiye Borç Listesi</h4>
    <a asp-action="VeresiyeExcel" class="btn btn-success">⬇️ Excel Olarak İndir</a>
</div>

<div class="mb-4">
    <div class="stat-card border-danger" style="max-width: 400px;">
        <div class="text-muted small mb-1">Toplam Açık Borç</div>
        <div class="h3 text-danger fw-bold mb-0">@Model.ToplamAcikBorc.ToTrParaMoney()</div>
    </div>
</div>

@if (Model.AcikVeresiyeler.Any())
{
    <div class="table-wrapper mb-4">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Müşteri</th>
                    <th class="text-end">Borç Tutarı</th>
                    <th>Tarih</th>
                    <th>Durum</th>
                    <th style="width: 120px;">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model.AcikVeresiyeler)
                {
                    var kalanBorc = v.Tutar - (v.Odemeler?.Sum(o => o.OdemeTutari) ?? 0);
                    <tr>
                        <td class="fw-bold">@(v.Musteri?.Ad) @(v.Musteri?.Soyad)</td>
                        <td class="text-danger fw-bold text-end">@kalanBorc.ToTrParaMoney()</td>
                        <td>@v.Tarih.ToTrDate()</td>
                        <td>
                            @if (v.OdenmeDurumu == OdenmeDurumu.Bekliyor)
                            {
                                <span class="badge bg-warning text-dark">Bekliyor</span>
                            }
                            else
                            {
                                <span class="badge" style="background-color:#fd7e14">Kısmi Ödendi</span>
                            }
                        </td>
                        <td>
                            @if (kalanBorc > 0)
                            {
                                <a asp-controller="Veresiye" asp-action="Odeme" asp-route-id="@v.Id" class="btn btn-sm btn-outline-success">Ödeme Al</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-light fw-bold">
                    <td>Toplam</td>
                    <td class="text-danger text-end">@Model.ToplamAcikBorc.ToTrParaMoney()</td>
                    <td colspan="3"></td>
                </tr>
            </tfoot>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">Açık veresiye borcu bulunmuyor.</div>
}
