@model CariErinc.ViewModels.CariEkstreVM
@using CariErinc.ViewModels
@{
    ViewData["Title"] = $"Hareket raporu — {Model.Ad}";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4 mt-2">
    <div>
        <h3 class="mb-1 fw-bold text-on-surface">Hareket raporu (ekstre)</h3>
        <div class="small text-muted">@Model.Ad · @Model.RolEtiketi</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Detail" asp-route-id="@Model.CariId" class="btn btn-sm btn-outline-secondary">Cari detay</a>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Cariler</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Güncel açık alacak</div>
                <div class="h5 text-success mb-0">@Model.AlacakToplam.ToTrParaMoney()</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Güncel açık verecek</div>
                <div class="h5 text-danger mb-0">@Model.VerecekToplam.ToTrParaMoney()</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Net (açık)</div>
                <div class="h5 mb-0 @(Model.NetBakiye >= 0 ? "text-primary" : "text-warning")">@Model.NetBakiye.ToTrParaMoney()</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Ekstre" class="row g-3 align-items-end">
            <input type="hidden" name="id" value="@Model.CariId" />
            <input type="hidden" name="page" value="1" />
            <div class="col-md-3">
                <label class="form-label small">Başlangıç</label>
                <input type="date" name="baslangic" class="form-control form-control-sm" value="@Model.Baslangic" />
            </div>
            <div class="col-md-3">
                <label class="form-label small">Bitiş</label>
                <input type="date" name="bitis" class="form-control form-control-sm" value="@Model.Bitis" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-sm btn-primary">Filtrele</button>
                <a asp-action="Ekstre" asp-route-id="@Model.CariId" class="btn btn-sm btn-outline-secondary">Temizle</a>
            </div>
            <div class="col-md-3 text-md-end small text-muted">
                Toplam @Model.TotalCount hareket (sayfa @Model.CurrentPage / @Model.TotalPages)
            </div>
        </form>
    </div>
</div>

<div class="table-wrapper card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-sm table-hover mb-0">
            <thead>
                <tr>
                    <th>Tarih</th>
                    <th>Taraf</th>
                    <th>İşlem</th>
                    <th class="text-end">Tutar</th>
                    <th>Açıklama</th>
                    <th style="width:90px;">Kayıt</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Satirlar)
                {
                    <tr>
                        <td>@r.Tarih.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@r.Taraf</td>
                        <td>@r.IslemTipi</td>
                        <td class="text-end fw-semibold">@r.Tutar.ToTrParaMoney()</td>
                        <td class="small text-muted">@(r.Aciklama ?? "—")</td>
                        <td>
                            @switch (r.Kaynak)
                            {
                                case "Satis":
                                    <a asp-controller="Satis" asp-action="Form" asp-route-id="@r.KaynakId" class="btn btn-sm btn-outline-secondary py-0">Satış</a>
                                    break;
                                case "Veresiye":
                                    <a asp-controller="Veresiye" asp-action="Detail" asp-route-id="@r.KaynakId" class="btn btn-sm btn-outline-secondary py-0">Veresiye</a>
                                    break;
                                case "VeresiyeOdeme":
                                    <a asp-controller="Veresiye" asp-action="Detail" asp-route-id="@(r.BagliVeresiyeId ?? r.KaynakId)" class="btn btn-sm btn-outline-secondary py-0">Detay</a>
                                    break;
                                case "Alis":
                                    <a asp-controller="Alis" asp-action="Detail" asp-route-id="@r.KaynakId" class="btn btn-sm btn-outline-secondary py-0">Alış</a>
                                    break;
                                case "AlisOdeme":
                                    <a asp-controller="Alis" asp-action="Detail" asp-route-id="@(r.BagliAlisId ?? r.KaynakId)" class="btn btn-sm btn-outline-secondary py-0">Alış</a>
                                    break;
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Satirlar.Any())
    {
        <div class="card-body text-muted">Seçilen aralıkta veya bu caride görüntülenecek hareket yok.</div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <div class="mt-3">
        @{
            var routeValues = new Dictionary<string, string>
            {
                ["id"] = Model.CariId.ToString(),
                ["baslangic"] = Model.Baslangic ?? "",
                ["bitis"] = Model.Bitis ?? ""
            };
        }
        @await Html.PartialAsync("_Pagination", new PaginationInfo
        {
            CurrentPage = Model.CurrentPage,
            TotalPages = Model.TotalPages,
            Action = "Ekstre",
            RouteValues = routeValues
        })
    </div>
}
